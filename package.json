{
  "name": "x_test",
  "version": "1.0.0",
  "description": "Local X research, momentum ranking, and HTTP publishing automation",
  "main": "automation.js",
  "scripts": {
    "news": "node tech_news.js --ranked --to-post",
    "post": "node post_thread.js",
    "browser:check": "node post_thread.js --browser-check",
    "start": "npm run web",
    "web": "npm run ui:build && node dashboard.js",
    "agent": "node agent_bridge.js",
    "audience:sync": "node audience.js",
    "automation": "node automation.js",
    "automation:once": "node automation.js --once",
    "viral:collect": "node viral_style_research.js collect",
    "viral:snapshot": "node viral_style_research.js snapshot",
    "viral:export": "node viral_style_research.js export",
    "viral:inspect": "node viral_style_research.js inspect",
    "ui:build": "cd ui && npm run build && cd .. && tailwindcss -i ./dashboard.tailwind.css -o ./dashboard.tailwind.generated.css --minify"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@opencode-ai/sdk": "^1.18.18",
    "@tailwindcss/cli": "^4.3.3",
    "bootstrap": "^5.3.8",
    "clearcote": "^0.27.0",
    "dotenv": "^17.4.2",
    "tailwindcss": "^4.3.3",
    "xactions": "^3.5.0"
  }
}
