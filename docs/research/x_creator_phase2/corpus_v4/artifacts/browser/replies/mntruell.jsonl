{"schemaVersion":4,"creatorIndex":6,"creatorName":"Michael Truell","creatorHandle":"mntruell","lane":"AI coding / founder","phase1Followers":226182,"authorHandle":"mntruell","authorUserId":"2755860644","authorName":"Michael Truell","authorFollowersObserved":226434,"authorFollowingObserved":911,"authorPostsObserved":274,"collectionSource":"browser_graphql_user_replies_timeline_v4","observedAt":"2026-09-03T20:16:32.188Z","id":"2043574966168555717","postType":"reply","text":"We A/B test many parts of Cursor: model checkpoints, UX, and the agent harness.\n\nIn this case, we tested less than 1% of traffic to compare how Claude behaves with the CC harness versus our default harness (something we do often with offline evals).\n\nOur team does lots to improve the speed, feel, and accuracy of our harness on the queries users ask and care about. Hope to share more about this work soon.","textSource":"note_tweet","textLength":407,"textPossiblyClipped":false,"timestampMs":1776061214000,"postedAt":"2026-04-13T06:20:14.000Z","postAgeHoursAtObservation":3445.9383855555557,"url":"https://x.com/mntruell/status/2043574966168555717","views":114754,"likes":786,"reposts":15,"replies":17,"bookmarks":153,"quotes":33,"metricAvailability":{"views":true,"likes":true,"reposts":true,"replies":true,"bookmarks":true,"quotes":true},"hashtags":[],"mentions":["jasonkneen"],"urls":[],"media":[],"photoCount":0,"videoCount":0,"quotedStatusId":null,"quotedPost":null,"inReplyToStatusId":"2043435856849940818","inReplyToUserId":"6392872","inReplyToUsername":"jasonkneen","conversationId":"2043435856849940818","repostedPost":null,"sensitiveContent":false,"recentOrdinal":10}
