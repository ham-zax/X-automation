{"schemaVersion":4,"creatorIndex":38,"creatorName":"Chip Huyen","creatorHandle":"chipro","lane":"AI systems engineering","phase1Followers":143486,"authorHandle":"chipro","authorUserId":"15278016","authorName":"Chip Huyen","authorFollowersObserved":143609,"authorFollowingObserved":719,"authorPostsObserved":586,"collectionSource":"browser_graphql_user_originals_timeline_v4","observedAt":"2026-09-03T21:26:57.008Z","id":"2086919041852268992","postType":"quote","text":"that's the problem he should've sent them in all caps https://t.co/zqNe1FPI7I","textSource":"legacy_full_text","textLength":77,"textPossiblyClipped":false,"timestampMs":1786395247000,"postedAt":"2026-08-10T20:54:07.000Z","postAgeHoursAtObservation":576.5472244444444,"url":"https://x.com/chipro/status/2086919041852268992","views":18237,"likes":98,"reposts":8,"replies":4,"bookmarks":6,"quotes":0,"metricAvailability":{"views":true,"likes":true,"reposts":true,"replies":true,"bookmarks":true,"quotes":true},"hashtags":[],"mentions":[],"urls":[],"media":[{"id":"2086918497528168448","type":"photo","url":"https://pbs.twimg.com/media/HPY5UQhbwAAuFhC.jpg","expandedUrl":"https://x.com/chipro/status/2086919041852268992/photo/1","altText":null,"width":1080,"height":832,"durationMs":null}],"photoCount":1,"videoCount":0,"quotedStatusId":"2086867246073401655","quotedPost":{"id":"2086867246073401655","authorHandle":"AnthropicAI","authorName":"Anthropic","authorFollowersObserved":1627220,"text":"We asked an unreleased research version of Claude to take a stab at the Riemann hypothesis.\n\nIt didn’t solve it, but it did make strides on a related problem: it increased the lower bound for the fraction of zeros of the Riemann zeta function that satisfy the hypothesis from 41.6% to 67.2%.\n\nhttps://t.co/aZDvqqhHRi","textSource":"note_tweet","postedAt":"2026-08-10T17:28:18.000Z","views":10253488,"likes":18336,"reposts":2011,"replies":938,"bookmarks":4237,"quotes":1328,"media":[],"photoCount":0,"videoCount":0},"inReplyToStatusId":