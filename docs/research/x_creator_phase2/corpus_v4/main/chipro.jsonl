{"schemaVersion":4,"creatorIndex":38,"creatorName":"Chip Huyen","creatorHandle":"chipro","lane":"AI systems engineering","phase1Followers":143486,"authorHandle":"chipro","authorUserId":"15278016","authorName":"Chip Huyen","authorFollowersObserved":143609,"authorFollowingObserved":719,"authorPostsObserved":586,"collectionSource":"browser_graphql_user_originals_timeline_v4","observedAt":"2026-09-03T21:26:57.008Z","id":"2016989494927643100","postType":"original","text":"I built https://t.co/4rAUTXjAhc to help me stay-up-date with new AI stuff.\n\nIt's tracking 14K open source repos so far, with contributions from over 145K developers.\n\nEvery day, it:\n- searches for new AI repos (based on 123 keywords and topics)\n- surfaces repos that are gaining traction, and\n- categorizes each repo\n\nThe annotations are done by AI so they are not super accurate, but they've helped me find some useful stuff.\n\nIt also lets me see where the contributors are, so when I travel, I can find folks doing cool stuff in a new city or country.","textSource":"note_tweet","textLength":553,"textPossiblyClipped":false,"timestampMs":1769722744000,"postedAt":"2026-01-29T21:39:04.000Z","postAgeHoursAtObservation":5207.798057777778,"url":"https://x.com/chipro/status/2016989494927643100","views":18562,"likes":252,"reposts":45,"replies":16,"bookmarks":205,"quotes":7,"metricAvailability":{"views":true,"likes":true,"reposts":true,"replies":true,"bookmarks":true,"quotes":true},"hashtags":[],"mentions":[],"urls":["http://GoodAIList.com"],"media":[{"id":"2016989137505832960","type":"photo","url":"https://pbs.twimg.com/media/G_3I7yDbUAALUxO.jpg","expandedUrl":"https://x.com/chipro/status/2016989494927643100/photo/1","altText":null,"width":2298,"height":1880,"durationMs":null},{"id":"2016989138524966912","type":"photo","url":"https://pbs.twimg.com/media/G_3I712aEAAiH8J.jpg","expandedUrl":"https://x.com/chipro/status/2016989494927643100/photo/1","altText":null,"width":2240,"height":1064,"durationMs":null}],"photoCount":2,"videoCount":0,"quotedStatusId":null,"quotedPost":null,"inReplyToStatusId":null,"inReplyToUserId":null,"inReplyToUsername":null,"conversationId":"2016989494927643100","repostedPost":null,"sensitiveContent":false,"recentOrdinal":10}
{"schemaVersion":4,"creatorIndex":38,"creatorName":"Chip Huyen","creatorHandle":"chipro","lane":"AI systems engineering","phase1Followers":143486,"authorHandle":"chipro","authorUserId":"15278016","authorName":"Chip Huyen","authorFollowersObserved":143609,"authorFollowingObserved":719,"authorPostsObserved":586,"collectionSource":"browser_graphql_user_originals_timeline_v4","observedAt":"2026-09-03T21:26:57.008Z","id":"2011485105081237618","postType":"original","text":"Super impressed by the projects at the Agentic Hackathon last weekend! Many teams work on really hard/important problems:\n\n* Long running tasks: memory management, recovering from mid-task failures, and maintaining consistency across steps and sub-agents\n\n* Adaptive retrieval from multiple sources: databases, search indices, and websites\n\n* Agents that work with voice, video, and even 3D environments\n\nIf you are in SF, come check out the finalist demos tomorrow! https://t.co/JytAN5xqyG\n\nThere will be talks by Douglas Eck, who is doing amazing work with Veo and Imagen and many other awesome folks.\n\nThanks @MongoDB  and @cerebral_valley for hosting and for letting me serve as a judge for these fantastic projects.","textSource":"note_tweet","textLength":720,"textPossiblyClipped":false,"timestampMs":1768410395000,"postedAt":"2026-01-14T17:06:35.000Z","postAgeHoursAtObservation":5572.339446666667,"url":"https://x.com/chipro/status/2011485105081237618","views":12064,"likes":90,"reposts":10,"replies":7,"bookmarks":50,"quotes":0,"metricAvailability":{"views":true,"likes":true,"reposts":true,"replies":true,"bookmarks":true,"quotes":true},"hashtags":[],"mentions":[],"urls":[],"media":[{"id":"2011484764004577281","type":"photo","url":"https://pbs.twimg.com/media/G-o6vE2acAEyecw.jpg","expandedUrl":"https://x.com/chipro/status/2011485105081237618/photo/1","altText":null,"width":3022,"height":1696,"durationMs":null}],"photoCount":1,"videoCount":0,"quotedStatusId":null,"quotedPost":null,"inReplyToStatusId":null,"inReplyToUserId":null,"inReplyToUsername":null,"conversationId":"2011485105081237618","repostedPost":null,"sensitiveContent":false,"recentOrdinal":11}
