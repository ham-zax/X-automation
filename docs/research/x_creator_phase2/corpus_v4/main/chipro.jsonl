{"schemaVersion":4,"creatorIndex":38,"creatorName":"Chip Huyen","creatorHandle":"chipro","lane":"AI systems engineering","phase1Followers":143486,"authorHandle":"chipro","authorUserId":"15278016","authorName":"Chip Huyen","authorFollowersObserved":143609,"authorFollowingObserved":719,"authorPostsObserved":586,"collectionSource":"browser_graphql_user_originals_timeline_v4","observedAt":"2026-09-03T21:26:57.008Z","id":"2047404818516615633","postType":"quote","text":"Congrats to @AlecRad @Luke_Metz and @soumithchintala!\n\nIt's really cool to see work produced by a group of 20-somethings without a single PhD between them winning this award.\n\nI hope to see these three collaborate again one day :)","textSource":"legacy_full_text","textLength":230,"textPossiblyClipped":false,"timestampMs":1776974322000,"postedAt":"2026-04-23T19:58:42.000Z","postAgeHoursAtObservation":3193.4708355555554,"url":"https://x.com/chipro/status/2047404818516615633","views":23591,"likes":122,"reposts":16,"replies":2,"bookmarks":30,"quotes":0,"metricAvailability":{"views":true,"likes":true,"reposts":true,"replies":true,"bookmarks":true,"quotes":true},"hashtags":[],"mentions":["AlecRad","Luke_Metz","soumithchintala"],"urls":[],"media":[],"photoCount":0,"videoCount":0,"quotedStatusId":"2047287536611963295","quotedPost":{"id":"2047287536611963295","authorHandle":"iclr_conf","authorName":"ICLR","authorFollowersObserved":61216,"text":"We are honored to announce the Test of Time awards for #ICLR2026 🏆 This award recognizes papers published 10 years ago at ICLR 2016 that have had a lasting impact on the field: \nhttps://t.co/JqYiqrAvgz https://t.co/xIZGtUPAB4","textSource":"legacy_full_text","postedAt":"2026-04-23T12:12:40.000Z","views":99890,"likes":330,"reposts":50,"replies":2,"bookmarks":61,"quotes":17,"media":[{"id":"2047287265131429888","type":"photo","url":"https://pbs.twimg.com/media/HGls669XAAAl51d.png","expandedUrl":"https://x.com/iclr_conf/status/2047287536611963295/photo/1","altText":null,"wi