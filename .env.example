# X authenticated read-session credentials.
# Browser automation is read-only; scripted x.com mutation is disabled.
# Option 1: Run `xactions login` or `xactions connect` for read/session access.
# Option 2: Fill in the cookie below manually from your own authenticated X session.
AUTH_TOKEN=your_auth_token_here

# Legacy/read-session cookie support. Scripted x.com mutation is disabled.
CT0=your_ct0_csrf_token_here

# Official X API v2 user-context mutation transport.
# Create an OAuth 2.0 Authorization Code + PKCE user token with tweet.read, tweet.write, users.read.
# Add offline.access if your credential workflow needs refresh tokens.
X_API_ACCESS_TOKEN=your_x_api_user_access_token_here
# Quote posting through POST /2/tweets currently requires X Enterprise access.
X_API_ENTERPRISE_QUOTE=false

# Research focus (comma-separated)
TOPICS=ai,agents,llm,mcp,coding,developer,devtools,open source,typescript,node,automation
X_NEWS_ACCOUNTS=github,OpenAI,ycombinator,TechCrunch
NEWS_LIMIT=8
X_ACCOUNT=ham_zax

# Web preview
WEB_PORT=3030
# WEB_HOST=127.0.0.1  # bind locally when fronted by an authenticated tunnel/proxy

# Optional AI secret-file location. API keys themselves do not belong in this file.
# AI_SECRETS_FILE=/home/you/.config/x-test/ai-secrets.json

# Automation loop
POLL_MINUTES=30
POST_INTERVAL_HOURS=4
MIN_DRAFT_SCORE=40

# Safety switch. Keep false until previews look right.
AUTO_POST=false
AUTO_EDITORIAL_PLAN_REFRESH=false
