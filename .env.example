# X / Twitter Authentication Credentials
# Option 1: Run `xactions login` or `xactions connect` in your terminal (recommended)
# Option 2: Fill in the cookies below manually (from browser DevTools -> Application -> Cookies -> https://x.com)

# Required for Browser & HTTP modes:
AUTH_TOKEN=your_auth_token_here

# Required for HTTP mode (CSRF token):
CT0=your_ct0_csrf_token_here

# Research focus (comma-separated)
TOPICS=ai,agents,llm,mcp,coding,developer,devtools,open source,typescript,node,automation
X_NEWS_ACCOUNTS=github,OpenAI,ycombinator,TechCrunch
NEWS_LIMIT=8
X_ACCOUNT=ham_zax

# Web preview
WEB_PORT=3030

# Optional AI secret-file location. API keys themselves do not belong in this file.
# AI_SECRETS_FILE=/home/you/.config/x-test/ai-secrets.json

# Automation loop
POLL_MINUTES=30
POST_INTERVAL_HOURS=4
MIN_DRAFT_SCORE=40

# Safety switch. Keep false until previews look right.
AUTO_POST=false
AUTO_EDITORIAL_PLAN_REFRESH=false
